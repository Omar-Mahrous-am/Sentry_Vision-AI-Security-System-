# ──────────────────────────────────────────────────────────────────────────────
# Sentry Vision — AI Security System
# Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development            # development | staging | production
DEBUG=true                     # Enable debug mode (true/false)
APP_HOST=0.0.0.0               # Host address to bind
APP_PORT=8000                  # Port for the FastAPI backend

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./users.db   # SQLAlchemy connection string

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*                 # Comma-separated allowed origins (* = all)

# ── Model Paths ───────────────────────────────────────────────────────────────
FIRE_MODEL_PATH=models/fire_model/fire_model.pth
WEAPON_MODEL_PATH=models/weapon_model/best.pt

# ── Upload Limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5           # Max upload file size in megabytes

# ── Docker Hub (for CI/CD deployment) ─────────────────────────────────────────
DOCKERHUB_USERNAME=            # Your Docker Hub username
DOCKERHUB_TOKEN=               # Your Docker Hub access token

# ── Frontend ──────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000   # URL the frontend uses to reach the backend
STREAMLIT_PORT=8501            # Port for the Streamlit frontend

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
